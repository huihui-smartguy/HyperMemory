{
  "name": "novamem-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "NovaMem 企业级智能体记忆系统 — 前端可视化面板",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "cross-env NEXT_PUBLIC_DATA_MODE=mock next dev",
    "dev:bff": "cross-env NEXT_PUBLIC_DATA_MODE=bff next dev",
    "dev:bff:fake": "cross-env NEXT_PUBLIC_DATA_MODE=bff BFF_USE_MOCK_BACKEND=1 next dev",
    "dev:live": "cross-env NEXT_PUBLIC_DATA_MODE=live next dev",
    "mock-backend": "node scripts/mock-novamem.mjs",
    "build": "next build",
    "build:bff": "cross-env NEXT_PUBLIC_DATA_MODE=bff next build",
    "build:live": "cross-env NEXT_PUBLIC_DATA_MODE=live next build",
    "start": "next start",
    "start:bff": "cross-env NEXT_PUBLIC_DATA_MODE=bff next start",
    "start:live": "cross-env NEXT_PUBLIC_DATA_MODE=live next start",
    "start:prod": "cross-env NEXT_PUBLIC_DATA_MODE=bff NEXT_PUBLIC_ENABLED_MODULES=vault,dev next start",
    "build:prod": "cross-env NEXT_PUBLIC_DATA_MODE=bff NEXT_PUBLIC_ENABLED_MODULES=vault,dev next build",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antv/g6": "^5.0.20",
    "@monaco-editor/react": "^4.6.0",
    "antd": "^5.21.0",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "framer-motion": "^11.11.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.2.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
