# ----------------------------------------------------------------
# HyperMemory · 前端数据源配置模板
# 复制本文件为 .env.local 并按需修改。Next.js 会自动读取。
# 仅 NEXT_PUBLIC_* 前缀的变量会被注入到客户端 bundle。
# ----------------------------------------------------------------

# 数据模式：mock（默认，本地静态数据）或 live（接入真实后端）
# 等价命令：
#   mock  → npm run dev      或 npm run dev:mock
#   live  → npm run dev:live （会临时覆盖此变量）
NEXT_PUBLIC_DATA_MODE=mock

# Go 网关 base URL。live 模式下所有 REST 与 SSE 都走此 base。
# 生产建议通过 nginx / k8s ingress 同源代理，避免 CORS 与 cookie 跨域。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 默认租户。会附加在 Header X-Tenant-Id；
# 后端 Go 网关据此完成多租户隔离与 IAM 校验。
NEXT_PUBLIC_TENANT=wealth-01

# SSE 实模式开关。仅在 live 模式 + 此变量 != 'false' 时启用 EventSource，
# 否则前端使用本地打字机模拟流（演示用）。
NEXT_PUBLIC_SSE_LIVE=true

# mock 模式下的人为延迟（毫秒），让 loading 态接近真实。
NEXT_PUBLIC_MOCK_LATENCY_MS=180
