# ----------------------------------------------------------------
# HyperMemory · 前端数据源配置模板
# 复制为 .env.local 并按需修改。Next.js 自动加载。
# 仅 NEXT_PUBLIC_* 前缀的变量会被注入到客户端 bundle。
# ----------------------------------------------------------------

# 数据模式三态：
#   mock — 默认，hook 直接读 lib/mocks/*，无网络请求
#   bff  — hook 走同源 /api/v1/...，Next.js Route Handler 收口、调 NovaMem 或 mock 兜底
#   live — hook 直连远端独立网关（远期，需后端补齐 18 端点）
NEXT_PUBLIC_DATA_MODE=mock

# live 模式时使用；bff 模式下保持空（fetch 自动走同源）
NEXT_PUBLIC_API_BASE_URL=

# 默认租户（中文展示名）。在 BFF 内通过 _tenant-map.ts 映射到后端的 user_id。
NEXT_PUBLIC_TENANT=理财部 · Wealth-01

# SSE 真实模式开关；false 时 ReasoningStream 使用本地 setTimeout 模拟。
NEXT_PUBLIC_SSE_LIVE=true

# mock 模式下的人为延迟（毫秒），让 loading 态接近真实。
NEXT_PUBLIC_MOCK_LATENCY_MS=180

# --- server-only 变量（不进入客户端 bundle）---

# NovaMem 后端 base URL。仅 BFF Route Handler 可见，防内网地址泄漏。
NOVAMEM_BASE_URL=http://localhost:8001

# =1 时 BFF 不发真实 HTTP，由 _novamem-client.ts 内吐预置 fixture。
# 适合无后端环境下的纯前端开发；npm run dev:bff:fake 自动启用。
BFF_USE_MOCK_BACKEND=0
